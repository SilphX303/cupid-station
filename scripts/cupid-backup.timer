# /etc/systemd/system/cupid-backup.timer
#
# Install on HV01:
#   sudo cp backup-cupid.sh /usr/local/bin/ && sudo chmod +x /usr/local/bin/backup-cupid.sh
#   sudo cp cupid-backup.service cupid-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cupid-backup.timer
# Verify: sudo systemctl start cupid-backup.service && ls /srv/backups/cupid
[Unit]
Description=Nightly cupid-data backup

[Timer]
OnCalendar=*-*-* 04:15:00
Persistent=true

[Install]
WantedBy=timers.target
